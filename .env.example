# Source Configuration
SOURCE_URL=https://www.karlsruhe.de/aktuelles
BASE_URL=https://www.karlsruhe.de

# HTTP retry behavior (one initial request plus HTTP_MAX_RETRIES fresh attempts)
HTTP_TIMEOUT_MS=30000
HTTP_MAX_RETRIES=3
HTTP_RETRY_BASE_DELAY_MS=5000
# HTTP_USER_AGENT=stadt-karlsruhe-news-syndication/1.0 (+https://github.com/your-username/stadt-karlsruhe-news-syndication)

# Feed Configuration
FEED_TITLE=Stadt Karlsruhe - Aktuelle Meldungen
FEED_DESCRIPTION=Offizielle Nachrichten der Stadt Karlsruhe
FEED_LANGUAGE=de

# GitHub Configuration (for auto-generating feed URL)
GITHUB_USERNAME=maxliesegang

# Or manually set the feed URL
# FEED_URL=https://maxliesegang.github.io/stadt-karlsruhe-syndication/feed.atom

# Output Configuration
MAX_ARTICLES=100
TRACKING_FILE=data/tracking.json
OUTPUT_FILE=docs/feed.atom

# Drop tracking entries for articles not seen within this many days
TRACKING_RETENTION_DAYS=365

# Logging
LOG_LEVEL=info
NODE_ENV=production
